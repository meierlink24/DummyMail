{
  "manifest_version": 3,
  "name": "Temp Email Generator",
  "version": "1.0",
  "description": "Generate temporary email addresses",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "48": "icon48.png",
      "96": "icon96.png"
    }
  },
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png"
  }
}